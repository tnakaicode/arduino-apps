[Unit]
Description=EPICS IOC for Rotary Encoder Dual Stepper
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=rpi
WorkingDirectory=/home/rpi/arduino-apps/ioc_rotary_encoder
ExecStart=/usr/bin/python3 RotaryEncoderApp/src/rotary_encoder_ioc.py --port /dev/ttyUSB0 --prefix RE:ch0:
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rotary-encoder-ioc

[Install]
WantedBy=multi-user.target
