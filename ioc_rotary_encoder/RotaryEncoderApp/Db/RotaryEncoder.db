# EPICS Database file for Rotary Encoder Dual Stepper
# PV records for encoder positions and motor positions
# For use with softIoc

record(longin, "$(P)$(R)ENC1:POSITION")
{
    field(DESC, "Encoder 1 Position (clicks)")
    field(SCAN, "Passive")
    field(EGU, "clicks")
}

record(longin, "$(P)$(R)ENC2:POSITION")
{
    field(DESC, "Encoder 2 Position (clicks)")
    field(SCAN, "Passive")
    field(EGU, "clicks")
}

record(longin, "$(P)$(R)MTR1:POSITION")
{
    field(DESC, "Motor 1 Current Position (steps)")
    field(SCAN, "Passive")
    field(EGU, "steps")
}

record(longin, "$(P)$(R)MTR2:POSITION")
{
    field(DESC, "Motor 2 Current Position (steps)")
    field(SCAN, "Passive")
    field(EGU, "steps")
}

record(bi, "$(P)$(R)SYNC:MODE")
{
    field(DESC, "Synchronization Mode")
    field(SCAN, "Passive")
    field(ZNAM, "Motor1 Only")
    field(ONAM, "Motor1+Motor2 Sync")
}

record(bi, "$(P)$(R)ARDUINO:CONNECTED")
{
    field(DESC, "Arduino serial connection state")
    field(SCAN, "Passive")
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
}

record(longin, "$(P)$(R)ARDUINO:LINES_PER_SEC")
{
    field(DESC, "Arduino frame rate")
    field(SCAN, "Passive")
    field(EGU, "lines/s")
}

record(longin, "$(P)$(R)ARDUINO:PARSE_OK")
{
    field(DESC, "Parsed frame count")
    field(SCAN, "Passive")
}

record(longin, "$(P)$(R)ARDUINO:PARSE_ERR")
{
    field(DESC, "Parse error frame count")
    field(SCAN, "Passive")
}

record(longin, "$(P)$(R)ARDUINO:RECONNECTS")
{
    field(DESC, "Serial reconnect count")
    field(SCAN, "Passive")
}

record(longin, "$(P)$(R)ARDUINO:LAST_RX_MS")
{
    field(DESC, "Elapsed ms since last received frame")
    field(SCAN, "Passive")
    field(EGU, "ms")
}

record(longin, "$(P)$(R)ARDUINO:LOOP_HZ")
{
    field(DESC, "Arduino loop rate reported by firmware")
    field(SCAN, "Passive")
    field(EGU, "Hz")
}

record(longin, "$(P)$(R)ARDUINO:LOOP_MS")
{
    field(DESC, "Arduino loop period reported by firmware")
    field(SCAN, "Passive")
    field(EGU, "ms")
}

record(longin, "$(P)$(R)ARDUINO:LOOP_US")
{
    field(DESC, "Arduino loop period microseconds reported by firmware")
    field(SCAN, "Passive")
    field(EGU, "us")
}

record(longin, "$(P)$(R)ARDUINO:UPTIME_MS")
{
    field(DESC, "Arduino uptime reported by firmware")
    field(SCAN, "Passive")
    field(EGU, "ms")
}

